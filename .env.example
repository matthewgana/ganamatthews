# ──────────────────────────────────────────────────────────────────────────────
# Portfolio Environment Variables — Example
# Copy this file to .env.local and fill in real values locally.
# In production, configure these in: Vercel → Settings → Environment Variables
# NEVER commit .env.local or any file containing real secrets.
# ──────────────────────────────────────────────────────────────────────────────

# Resend API key — required at RUNTIME for the /api/contact route to send email.
# Obtain your key from: https://resend.com/api-keys
RESEND_API_KEY=

# Optional: override the inbox that receives contact-form messages.
# Defaults to matthewgana95@gmail.com if not set.
# CONTACT_RECEIVER_EMAIL=
